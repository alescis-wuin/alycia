<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <AvaloniaResource Include="Assets/Brand/alycia-boreale.svg" />
    <AvaloniaResource Include="Assets/Fonts/**/*.ttf" />
    <None Update="Assets/Fonts/**/NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="CSharpMath.SkiaSharp" Version="1.0.0-pre.2" />
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Alycia.Contracts" Version="[0.1.0]" />
  </ItemGroup>
</Project>
