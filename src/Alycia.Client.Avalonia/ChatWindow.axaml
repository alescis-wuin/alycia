<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Alycia.Client.Avalonia"
        x:Class="Alycia.Client.Avalonia.ChatWindow"
        Title="Alycia — Chat local" Background="#10131E" Foreground="#E7EAF5"
        Width="1240" Height="880" MinWidth="880" MinHeight="650">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="#23293C" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#8875F5" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A8B2CC" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#191E2D" />
      <Setter Property="BorderBrush" Value="#30384F" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#A8B2CC" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#23293C" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#302B50" />
      <Setter Property="BorderBrush" Value="#8875F5" />
    </Style>
    <Style Selector="Border.message">
      <Setter Property="Margin" Value="0,0,24,20" />
      <Setter Property="Background" Value="#1A2030" />
      <Setter Property="BorderBrush" Value="#3BCEB5" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Border.message.file">
      <Setter Property="Background" Value="#232B3C" />
      <Setter Property="BorderBrush" Value="#E5B96B" />
    </Style>
    <Style Selector="Border.message.user">
      <Setter Property="Background" Value="#25223B" />
      <Setter Property="BorderBrush" Value="#A493FF" />
      <Setter Property="Margin" Value="32,0,0,20" />
    </Style>
  </Window.Styles>
  <Grid x:Name="ShellGrid" ColumnDefinitions="Auto,*">
    <Border x:Name="Sidebar" Width="260" Background="#171B29" Padding="18,24,18,18">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="18">
        <StackPanel Spacing="3">
          <TextBlock Text="alycia" FontSize="27" FontWeight="SemiBold" Foreground="#C6BCFF" />
          <TextBlock Text="Votre atelier IA local" FontSize="12" Foreground="#9EA9C3" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="10" x:Name="CreationPanel">
          <TextBlock Text="Modèle pour une nouvelle conversation" FontSize="11" Foreground="#A8B2CC" />
          <ComboBox x:Name="ModelSelector" HorizontalAlignment="Stretch" PlaceholderText="Choisir un modèle Ollama" />
          <Button x:Name="NewButton" Classes="primary" Content="+  Nouvelle conversation" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" ToolTip.Tip="Créer une conversation · Ctrl+N" />
          <Expander Header="Titre et instruction initiale" FontSize="11" BorderThickness="0" Padding="0">
            <StackPanel Spacing="8" Margin="0,8,0,0">
              <TextBox x:Name="NewTitleInput" PlaceholderText="Titre facultatif" MaxLength="100" />
              <TextBox x:Name="SystemPromptInput" AcceptsReturn="True" Height="80" TextWrapping="Wrap" MaxLength="4000"
                       Text="Tu es Alycia, un assistant utile. Réponds en français." />
            </StackPanel>
          </Expander>
        </StackPanel>
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="4">
          <TextBox x:Name="SearchInput" PlaceholderText="Rechercher une conversation…" MaxLength="200" ToolTip.Tip="Titre ou contenu des messages · Ctrl+F" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
            <Button x:Name="SearchButton" Classes="quiet" Content="Rechercher" FontSize="11" Padding="8,4" />
            <Button x:Name="MoreConversationsButton" Classes="quiet" Content="Suivantes" FontSize="11" Padding="8,4" IsVisible="False" />
          </StackPanel>
        </Grid>
        <ListBox Grid.Row="3" x:Name="ConversationList" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:ConversationSummary">
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="Medium" Foreground="#E7EAF5" />
                <TextBlock Text="{Binding Model}" FontSize="11" Foreground="#9B91C8" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="4" Spacing="3">
          <Button x:Name="RefreshButton" Classes="quiet" Content="Actualiser modèles et historique" FontSize="11" HorizontalAlignment="Stretch" />
          <Expander Header="Prompts et outils" FontSize="12" BorderThickness="0" Padding="0">
            <StackPanel Spacing="3">
              <Button x:Name="PromptsButton" Classes="quiet" Content="Bibliothèque de prompts" FontSize="11" HorizontalAlignment="Stretch" />
              <Button x:Name="ImportConversationButton" Classes="quiet" Content="Importer une conversation JSON" FontSize="11" HorizontalAlignment="Stretch" />
              <Button x:Name="DiagnosticsButton" Classes="quiet" Content="Connexion et diagnostics" FontSize="11" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="24,20,24,18" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Button x:Name="SidebarToggle" Content="☰" Classes="quiet" ToolTip.Tip="Afficher ou masquer les conversations" />
        <Grid Grid.Column="1" x:Name="ConversationHeader" ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox x:Name="TitleInput" PlaceholderText="Votre prochaine idée commence ici" MaxLength="100"
                   Background="Transparent" BorderThickness="0" FontSize="20" FontWeight="SemiBold" Padding="0,8" />
          <Button Grid.Column="1" x:Name="RenameButton" Classes="quiet" Content="Renommer" FontSize="11" />
        </Grid>
      </Grid>
      <StackPanel Grid.Row="1" Spacing="6">
        <TextBlock x:Name="ConversationDetails" Text="Choisissez un modèle, puis créez une conversation."
                   Foreground="#9DAAC2" FontSize="12" TextWrapping="Wrap" />
        <WrapPanel x:Name="ConversationTools" Orientation="Horizontal">
          <Button x:Name="SettingsButton" Classes="quiet" Content="Réglages" FontSize="12" ToolTip.Tip="Modèle, prompt, contexte et génération" />
          <Button x:Name="ContextButton" Classes="quiet" Content="Mémoire et contexte" FontSize="12" ToolTip.Tip="Voir le contexte, préparer ou réinitialiser le résumé" />
          <Button x:Name="FilesButton" Classes="quiet" Content="Documents" FontSize="12" ToolTip.Tip="Épingler ou exclure les fichiers importés" />
          <Button x:Name="AnalysisButton" Classes="quiet" Content="Synthèses de dossiers" FontSize="12" ToolTip.Tip="Inventaire tree.txt et résumés récursifs" />
          <Expander Header="Autres actions" FontSize="11" BorderThickness="0" Padding="0">
            <WrapPanel>
              <Button x:Name="ForkButton" Classes="quiet" Content="Dupliquer" FontSize="11" />
              <Button x:Name="RegenerateButton" Classes="quiet" Content="Régénérer une copie" FontSize="11" />
              <Button x:Name="ExportButton" Classes="quiet" Content="Exporter" FontSize="11" />
              <Button x:Name="DeleteButton" Classes="quiet" Content="Supprimer" FontSize="11" Foreground="#ECA8B5" />
            </WrapPanel>
          </Expander>
        </WrapPanel>
      </StackPanel>
      <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
        <Button x:Name="OlderButton" Classes="quiet" Content="Charger les messages précédents" IsVisible="False"
                HorizontalAlignment="Center" Margin="0,0,0,10" FontSize="12" />
        <StackPanel Grid.Row="1" x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" IsHitTestVisible="False" Margin="24">
          <TextBlock Text="Que souhaitez-vous construire ?" FontSize="25" FontWeight="SemiBold" Foreground="#C5B9FF" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock x:Name="EmptyHint" Text="Choisissez un modèle local et créez une conversation." FontSize="14" Foreground="#A9B6CE" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="Discutez d’une idée · Analysez un dossier · Développez avec vos sources" FontSize="12" Foreground="#8797B3" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" x:Name="MessageScroll" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="0" Margin="0,0,8,0">
            <ItemsControl x:Name="MessageList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ChatMessageItem">
                  <Border Classes="message" Classes.user="{Binding IsUser}" Classes.file="{Binding IsFile}" Padding="18,16" CornerRadius="12">
                    <StackPanel Spacing="12">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#ACBBD2" FontSize="11" />
                      <local:MarkdownView Text="{Binding Content}" IsMarkdown="{Binding IsAssistant}" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="quiet" Content="Copier" CommandParameter="{Binding}" Click="CopyMessageClick" FontSize="11" Padding="8,4" />
                        <Button Classes="quiet" Content="Tout le code" IsVisible="{Binding HasCode}" CommandParameter="{Binding}" Click="CopyCodeClick" FontSize="11" Padding="8,4" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsFile}">
                        <Button Classes="quiet" Content="Télécharger" CommandParameter="{Binding}" Click="DownloadFileClick" FontSize="11" />
                        <Button Classes="quiet" Content="Retirer" CommandParameter="{Binding}" Click="RemoveFileClick" FontSize="11" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="PendingUserPanel" Classes="message user" IsVisible="False" Padding="18,16" CornerRadius="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Vous · envoi en cours" FontSize="11" Foreground="#ACBBD2" />
                <SelectableTextBlock x:Name="PendingUserText" TextWrapping="Wrap" FontSize="15" />
              </StackPanel>
            </Border>
            <Expander x:Name="StreamingPanel" Header="Alycia · génération en cours" IsVisible="False" IsExpanded="True" HorizontalAlignment="Stretch">
              <Border Padding="18,16" Background="#1A2030" CornerRadius="12" BorderBrush="#3BCEB5" BorderThickness="3,0,0,0">
                <StackPanel Spacing="10">
                  <TextBlock x:Name="StreamingStatus" Text="Préparation…" FontSize="11" Foreground="#A3CFC9" TextWrapping="Wrap" />
                  <local:MarkdownView x:Name="StreamingText" IsStreaming="True" />
                </StackPanel>
              </Border>
            </Expander>
          </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" x:Name="LatestButton" Content="↓  Revenir à la réponse" Classes="quiet" IsVisible="False" HorizontalAlignment="Right" FontSize="11" />
      </Grid>
      <StackPanel Grid.Row="3" Spacing="6">
        <ProgressBar x:Name="BusyIndicator" IsIndeterminate="True" IsVisible="False" Height="3" Foreground="#8875F5" />
        <TextBlock x:Name="FeedbackText" Text="Connexion…" TextWrapping="Wrap" FontSize="12" Foreground="#A0AEC8" />
      </StackPanel>
      <Border Grid.Row="4" Background="#1A2030" CornerRadius="16" BorderBrush="#3F4A65" BorderThickness="1" Padding="12">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
          <TextBox x:Name="MessageInput" PlaceholderText="Votre demande… Les deux derniers échanges restent dans le contexte."
                   AcceptsReturn="True" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" MinHeight="72" MaxHeight="160" MaxLength="32000" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button x:Name="UploadButton" Classes="quiet" Content="+ Fichiers / ZIP" FontSize="11" ToolTip.Tip="Importer des fichiers ou archives récursives" />
              <Button x:Name="FolderButton" Classes="quiet" Content="+ Dossier" FontSize="11" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button x:Name="CancelButton" Content="Arrêter" IsVisible="False" ToolTip.Tip="Interrompre l’opération · Échap" />
              <Button x:Name="SendButton" Classes="primary" Content="Envoyer  →" Padding="18,10" ToolTip.Tip="Envoyer · Ctrl+Entrée" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
