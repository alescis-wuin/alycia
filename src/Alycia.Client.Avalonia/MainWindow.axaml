<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Alycia.Client.Avalonia.MainWindow"
        Title="Alycia — Owner initialization"
        Width="660"
        Height="735"
        MinWidth="460"
        MinHeight="530">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="12">
            <TextBlock Text="Backend connection"
                       FontSize="24"
                       FontWeight="SemiBold" />

            <TextBlock x:Name="StatusText"
                       Text="Checking..."
                       FontSize="18" />

            <TextBlock x:Name="DetailsText"
                       Text="Checking API connectivity..."
                       TextWrapping="Wrap" />

            <Button x:Name="RetryButton"
                    Content="Check backend again"
                    HorizontalAlignment="Left" />

            <Separator Margin="0,12,0,4" />

            <TextBlock Text="Initialize the owner"
                       FontSize="22"
                       FontWeight="SemiBold" />

            <TextBlock Text="One-time setup only. Generate a 15-minute secret with the local administrative command. No sign-in session is created."
                       TextWrapping="Wrap" />

            <TextBlock Text="Bootstrap status" />
            <TextBlock x:Name="OwnerStatusText"
                       Text="Checking..."
                       FontWeight="SemiBold" />
            <TextBlock x:Name="OwnerDetailsText"
                       Text="Checking initialization status..."
                       TextWrapping="Wrap" />

            <Button x:Name="RetryOwnerStatusButton"
                    Content="Refresh setup status"
                    HorizontalAlignment="Left" />

            <TextBlock Text="Administrative bootstrap secret" />
            <TextBox x:Name="OwnerSecretInput"
                     PasswordChar="*"
                     PlaceholderText="Paste the temporary secret" />

            <TextBlock Text="Local username (3–64 ASCII characters)" />
            <TextBox x:Name="OwnerLoginInput"
                     PlaceholderText="Letters, digits, dots, hyphens or underscores" />

            <TextBlock Text="Password (15–128 Unicode code points after NFC)" />
            <TextBox x:Name="OwnerPasswordInput"
                     PasswordChar="*"
                     PlaceholderText="No uppercase, number or symbol requirement" />

            <TextBlock Text="Confirm password" />
            <TextBox x:Name="OwnerConfirmationInput"
                     PasswordChar="*"
                     PlaceholderText="Re-enter the password" />

            <TextBlock Text="Passwords in the local common/compromised list are rejected. Spaces are preserved."
                       TextWrapping="Wrap" />

            <Button x:Name="InitializeOwnerButton"
                    Content="Initialize owner"
                    IsEnabled="False"
                    HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Window>
