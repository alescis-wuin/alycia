<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Alicia.Presentation.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#090D18" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0D1321" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#131B2E" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1A2540" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#22304E" />
    <SolidColorBrush x:Key="BorderBrush" Color="#31405F" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F9FF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BBC5DD" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#090D18" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8C7CFF" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#43E6D1" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#72E6A7" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#173329" />
    <SolidColorBrush x:Key="UserMessageSurfaceBrush" Color="#24204A" />
    <SolidColorBrush x:Key="AssistantMessageSurfaceBrush" Color="#132B2D" />
    <SolidColorBrush x:Key="SystemMessageSurfaceBrush" Color="#20283A" />
    <SolidColorBrush x:Key="EditBrush" Color="#FFB454" />
    <SolidColorBrush x:Key="EditSurfaceBrush" Color="#3A2B19" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5F74" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#391D2A" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="FontSize" Value="16" />
    </Style>

    <Style Selector="Border.surface">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
    </Style>

    <Style Selector="Border.status-chip">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,7" />
    </Style>

    <Style Selector="Button.primary-action">
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.secondary-action">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.danger-action">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.history-row">
      <Setter Property="MinHeight" Value="68" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.history-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="Border.history-row:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>

    <Style Selector="Border.history-row.selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>

    <Style Selector="Border.history-row.editing">
      <Setter Property="Background" Value="{DynamicResource EditSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EditBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.history-item">
      <Setter Property="MinHeight" Value="66" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.history-row StackPanel.history-actions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Border.history-row:pointerover StackPanel.history-actions">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style Selector="Border.history-row:focus-within StackPanel.history-actions">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style Selector="Button.history-action">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="Button.history-action.edit-history-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource EditSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EditBrush}" />
    </Style>

    <Style Selector="Button.history-action.delete-history-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.history-action.save-history-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style Selector="Button.history-action.edit-history-action:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource EditBrush}" />
    </Style>

    <Style Selector="Button.history-action.delete-history-action:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.history-action.save-history-action:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style Selector="TextBox.history-search">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextOnAccentBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>

    <Style Selector="TextBox.history-search:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.history-collapse-action">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.history-collapse-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="Button.create-conversation-action">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.history-preview-card">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style Selector="Button.history-reopen-action">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.history-reopen-action:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="Button.scroll-to-latest-action">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="MinWidth" Value="42" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="21" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.scroll-to-latest-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.history-item:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.48" />
    </Style>

    <Style Selector="TextBox.inline-rename">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EditBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="SelectionBrush" Value="{DynamicResource EditBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextOnAccentBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource EditBrush}" />
    </Style>

    <Style Selector="TextBox.inline-rename:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource EditBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Border.conversation-thread-shell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBlock.thinking-indicator">
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Opacity" Value="0.78" />
    </Style>

    <Style Selector="Expander.reasoning-expander">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style Selector="Border.reasoning-step">
      <Setter Property="Padding" Value="2,4,2,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Opacity" Value="0.82" />
    </Style>

    <Style Selector="Border.message-bubble">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="MaxWidth" Value="840" />
    </Style>

    <Style Selector="Border.message-bubble.user-message">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="MaxWidth" Value="760" />
    </Style>

    <Style Selector="Border.message-bubble.assistant-message">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="Border.message-bubble.system-message">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="MaxWidth" Value="640" />
    </Style>

    <Style Selector="TextBlock.message-role.user-message-role">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="TextBlock.message-role.assistant-message-role">
      <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.message-role.system-message-role">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="Border.message-composer-shell">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="10" />
    </Style>

    <Style Selector="Border.message-composer-shell:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
    </Style>

    <Style Selector="Border.message-composer-shell Button">
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="TextBox.message-composer">
      <Setter Property="MinHeight" Value="54" />
      <Setter Property="MaxHeight" Value="180" />
      <Setter Property="Padding" Value="12,11" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="TextBox.message-composer:focus">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.send-action">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.composer-secondary-action">
      <Setter Property="MinHeight" Value="48" />
    </Style>

    <Style Selector="Button.send-action:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Application.Styles>
</Application>
