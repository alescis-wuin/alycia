<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alicia.Presentation.ViewModels"
             x:Class="Alicia.Presentation.Views.ModelWorkspaceView"
             x:DataType="vm:MainViewModel"
             AutomationProperties.Name="Models workspace"
             AutomationProperties.LandmarkType="Main"
             AutomationProperties.AccessibilityView="Control">
  <Grid Margin="28" RowDefinitions="Auto,18,*">
    <Grid MaxWidth="1120" HorizontalAlignment="Center" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Models"
                   FontSize="30"
                   FontWeight="Bold"
                   AutomationProperties.HeadingLevel="1"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="Manage saved models and restart-sensitive loading settings. Generation behavior is configured in Profiles."
                   FontSize="14"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>

      <Border Grid.Column="1" Classes="status-chip workspace-status-chip" VerticalAlignment="Center">
        <TextBlock Text="{Binding ProviderName}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
      </Border>
    </Grid>

    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Border MaxWidth="1120"
              HorizontalAlignment="Center"
              Classes="workspace-primary-surface"
              Padding="22">
        <StackPanel Spacing="20">
          <Border Classes="workspace-secondary-surface" Padding="18">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="workspace-section-title"
                           Text="Model library"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock Classes="workspace-section-description"
                           Text="Keep multiple saved model configurations without pretending they are loaded. Reusing an entry fills only model loading settings; generation behavior remains profile-owned." />
              </StackPanel>

              <ListBox ItemsSource="{Binding ModelLibraryItems}"
                       SelectedItem="{Binding SelectedModelLibraryItem, Mode=TwoWay}"
                       MaxHeight="260"
                       AutomationProperties.Name="Saved model library">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:InferenceModelLibraryItemViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,6" ColumnSpacing="16">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ModelReference}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding RuntimeSummaryText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding QuantizationText}"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding StateText}"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SavedAtText}"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Text="{Binding ModelLibraryStatusText}"
                         FontSize="12"
                         LineHeight="18"
                         TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Polite"
                         Foreground="{DynamicResource TextSecondaryBrush}" />

              <WrapPanel Orientation="Horizontal">
                <Button Classes="secondary-action"
                        Margin="0,0,8,8"
                        Command="{Binding SaveCurrentModelToLibraryCommand}"
                        IsEnabled="{Binding CanSaveCurrentModelToLibrary}"
                        Content="Save current model to library"
                        AutomationProperties.Name="Save current model configuration to library" />
                <Button Classes="secondary-action"
                        Margin="0,0,0,8"
                        Command="{Binding UseSelectedLibraryModelCommand}"
                        IsEnabled="{Binding CanUseSelectedLibraryModel}"
                        Content="Use model settings"
                        AutomationProperties.Name="Use selected library model loading settings"
                        AutomationProperties.HelpText="Copies only the selected model reference and restart-sensitive runtime settings. Generation behavior is not copied. This does not save, start, or load the model automatically." />
              </WrapPanel>
            </StackPanel>
          </Border>

          <StackPanel Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Classes="workspace-section-title"
                         Text="Model configuration"
                         AutomationProperties.HeadingLevel="2" />
              <TextBlock Classes="workspace-section-description"
                         Text="Only settings that affect model loading or require a reload belong here. Per-generation behavior is configured in Profiles." />
            </StackPanel>

            <TextBox Text="{Binding ProviderModelReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="owner/model-GGUF[:quant]"
                     IsEnabled="{Binding IsProviderModelEditable}"
                     AutomationProperties.Name="Model reference"
                     AutomationProperties.HelpText="For llama.cpp, enter a compatible Hugging Face GGUF repository. Optional quantization can follow a colon."
                     ToolTip.Tip="Model passed directly to llama-server with -hf" />

            <Expander Header="Runtime"
                      Classes="workspace-disclosure"
                      IsExpanded="True"
                      IsEnabled="{Binding IsProviderSettingsEditable}"
                      AutomationProperties.Name="Runtime settings">
              <StackPanel Spacing="8" Margin="0,10,0,0">
                <TextBox Text="{Binding ProviderContextSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Context size • model default"
                         AutomationProperties.Name="Context size"
                         AutomationProperties.HelpText="Optional prompt context size. Leave blank to use the model or provider default." />
              </StackPanel>
            </Expander>

            <TextBlock Text="{Binding ProviderConfigurationValidationText}"
                       IsVisible="{Binding HasProviderConfigurationValidationError}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource DangerBrush}" />

            <Button Classes="primary-action"
                    Command="{Binding SaveProviderConfigurationCommand}"
                    IsEnabled="{Binding CanSaveProviderConfiguration}"
                    Content="Save model settings"
                    AutomationProperties.Name="Save model loading settings" />
          </StackPanel>

          <Border Classes="workspace-secondary-surface" Padding="18" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Classes="workspace-section-title"
                         Text="Summary"
                         AutomationProperties.HeadingLevel="2" />

              <TextBlock Text="Provider"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding ProviderName}"
                         FontSize="17"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding ProviderStatusText}"
                         FontSize="13"
                         Foreground="{DynamicResource TextSecondaryBrush}" />

              <TextBlock Text="{Binding ProviderConfigurationStatusText}"
                         Margin="0,8,0,0"
                         FontSize="13"
                         LineHeight="20"
                         TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Polite"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="Generation instructions, sampling, output limits, seed, and reasoning are managed in the dedicated Profiles workspace."
                         FontSize="12"
                         LineHeight="18"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
