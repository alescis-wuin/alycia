<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alicia.Presentation.ViewModels"
             xmlns:generations="using:Alicia.Application.Generations"
             x:Class="Alicia.Presentation.Views.ModelWorkspaceView"
             x:DataType="vm:MainViewModel"
             AutomationProperties.Name="Models workspace"
             AutomationProperties.LandmarkType="Main"
             AutomationProperties.AccessibilityView="Control">
  <Grid Margin="28"
        RowDefinitions="Auto,18,*">

    <Grid MaxWidth="1120"
          HorizontalAlignment="Center"
          ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Models"
                   FontSize="30"
                   FontWeight="Bold"
                   AutomationProperties.HeadingLevel="1"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="Configure the model reference and provider-neutral generation options."
                   FontSize="14"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>

      <Border Grid.Column="1"
              Classes="status-chip workspace-status-chip"
              VerticalAlignment="Center">
        <TextBlock Text="{Binding ProviderName}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
      </Border>
    </Grid>

    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Border MaxWidth="1120"
              HorizontalAlignment="Center"
              Classes="workspace-primary-surface"
              Padding="22">
        <StackPanel Spacing="20">
          <StackPanel Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Classes="workspace-section-title"
                         Text="Model configuration"
                         AutomationProperties.HeadingLevel="2" />
              <TextBlock Classes="workspace-section-description"
                         Text="Keep the model identity visible and group advanced runtime or generation controls below it." />
            </StackPanel>

            <TextBox Text="{Binding ProviderModelReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="owner/model-GGUF[:quant]"
                     IsEnabled="{Binding IsProviderModelEditable}"
                     AutomationProperties.Name="Model reference"
                     AutomationProperties.HelpText="For llama.cpp, enter a compatible Hugging Face GGUF repository. Optional quantization can follow a colon."
                     ToolTip.Tip="Model passed directly to llama-server with -hf" />

            <Expander Header="Runtime"
                      Classes="workspace-disclosure"
                      IsExpanded="True"
                      IsEnabled="{Binding IsProviderSettingsEditable}"
                      AutomationProperties.Name="Runtime settings">
              <StackPanel Spacing="8" Margin="0,10,0,0">
                <TextBox Text="{Binding ProviderContextSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Context size • model default"
                         AutomationProperties.Name="Context size"
                         AutomationProperties.HelpText="Optional prompt context size. Leave blank to use the model or provider default." />
              </StackPanel>
            </Expander>

            <Expander Header="Generation"
                      Classes="workspace-disclosure"
                      IsExpanded="True"
                      IsEnabled="{Binding IsProviderSettingsEditable}"
                      AutomationProperties.Name="Generation settings">
              <StackPanel Spacing="8" Margin="0,10,0,0">
                <TextBox Text="{Binding ProviderMaxOutputTokensText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Max output tokens • provider default"
                         AutomationProperties.Name="Maximum output tokens" />
                <TextBox Text="{Binding ProviderTemperatureText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Temperature • provider default"
                         AutomationProperties.Name="Temperature" />
                <TextBox Text="{Binding ProviderTopPText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Top-p • provider default"
                         AutomationProperties.Name="Top-p" />
                <TextBox Text="{Binding ProviderTopKText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Top-k • provider default"
                         AutomationProperties.Name="Top-k" />
                <TextBox Text="{Binding ProviderSeedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Seed • provider random"
                         AutomationProperties.Name="Random seed" />

                <Border Classes="workspace-secondary-surface"
                        Margin="0,6,0,0"
                        Padding="14">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Reasoning"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Text="Show model reasoning separately from the final response."
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding ProviderReasoningEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Enable model reasoning"
                                  AutomationProperties.HelpText="When disabled Alicia asks llama.cpp to skip reasoning. When enabled reasoning streams separately from the final answer." />
                  </Grid>
                </Border>

                <TextBox Text="{Binding ProviderReasoningBudgetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsProviderReasoningBudgetEditable}"
                         PlaceholderText="Reasoning budget tokens • 512 recommended"
                         AutomationProperties.Name="Reasoning token budget"
                         AutomationProperties.HelpText="Maximum reasoning tokens sent to llama.cpp for each response. Alicia proposes 512 when no explicit budget exists." />
              </StackPanel>
            </Expander>

            <TextBlock Text="{Binding ProviderConfigurationValidationText}"
                       IsVisible="{Binding HasProviderConfigurationValidationError}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource DangerBrush}" />

            <Button Classes="primary-action"
                    Command="{Binding SaveProviderConfigurationCommand}"
                    IsEnabled="{Binding CanSaveProviderConfiguration}"
                    Content="Save settings"
                    AutomationProperties.Name="Save model and generation settings" />
          </StackPanel>

          <Border Classes="workspace-secondary-surface"
                  Padding="18">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="workspace-section-title"
                           Text="Generation profile"
                           AutomationProperties.HeadingLevel="2" />
                <TextBlock Classes="workspace-section-description"
                           Text="Choose the confirmed profile used by the active conversation branch, or create and revise a custom profile for this saved model." />
              </StackPanel>

              <TextBlock Text="{Binding GenerationProfileScopeText}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         AutomationProperties.Name="Generation profile model scope" />

              <ComboBox ItemsSource="{Binding GenerationProfiles}"
                        SelectedItem="{Binding SelectedGenerationProfile, Mode=TwoWay}"
                        IsEnabled="{Binding IsGenerationProfileSelectionEditable}"
                        AutomationProperties.Name="Generation profile"
                        AutomationProperties.HelpText="Select the confirmed generation profile to bind explicitly to the active conversation branch.">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="generations:GenerationProfile">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Text="{Binding GenerationProfileSelectionStatusText}"
                         FontSize="12"
                         LineHeight="18"
                         TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Polite"
                         Foreground="{DynamicResource TextSecondaryBrush}" />

              <WrapPanel Orientation="Horizontal">
                <Button Classes="secondary-action"
                        Margin="0,0,8,8"
                        Command="{Binding SaveGenerationProfileSelectionCommand}"
                        IsEnabled="{Binding CanSaveGenerationProfileSelection}"
                        Content="Use profile for this branch"
                        AutomationProperties.Name="Use selected generation profile for active branch" />
                <Button Classes="secondary-action"
                        Margin="0,0,8,8"
                        Command="{Binding BeginCreateGenerationProfileCommand}"
                        IsEnabled="{Binding CanCreateGenerationProfile}"
                        Content="New profile"
                        AutomationProperties.Name="Create custom generation profile" />
                <Button Classes="secondary-action"
                        Margin="0,0,0,8"
                        Command="{Binding BeginEditGenerationProfileCommand}"
                        IsEnabled="{Binding CanEditSelectedGenerationProfile}"
                        Content="Edit profile"
                        AutomationProperties.Name="Edit selected custom generation profile" />
              </WrapPanel>

              <Border Classes="workspace-primary-surface"
                      Padding="16"
                      IsVisible="{Binding IsGenerationProfileEditorVisible}"
                      IsEnabled="{Binding CanEditGenerationProfileDraft}">
                <StackPanel Spacing="10">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Profile editor"
                               FontSize="16"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="3"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding GenerationProfileEditor.StatusText}"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>

                  <TextBox Text="{Binding GenerationProfileEditor.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="Profile name"
                           AutomationProperties.Name="Generation profile name" />

                  <TextBox Text="{Binding GenerationProfileEditor.BaseSystemInstructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="92"
                           PlaceholderText="Base system instructions • optional"
                           AutomationProperties.Name="Generation profile system instructions" />

                  <Expander Header="Generation overrides"
                            Classes="workspace-disclosure"
                            IsExpanded="True"
                            AutomationProperties.Name="Generation profile overrides">
                    <StackPanel Spacing="8" Margin="0,10,0,0">
                      <TextBox Text="{Binding GenerationProfileEditor.MaxOutputTokensText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="Max output tokens • provider default"
                               AutomationProperties.Name="Profile maximum output tokens" />
                      <TextBox Text="{Binding GenerationProfileEditor.TemperatureText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="Temperature • provider default"
                               AutomationProperties.Name="Profile temperature" />
                      <TextBox Text="{Binding GenerationProfileEditor.TopPText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="Top-p • provider default"
                               AutomationProperties.Name="Profile top-p" />
                      <TextBox Text="{Binding GenerationProfileEditor.TopKText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="Top-k • provider default"
                               AutomationProperties.Name="Profile top-k" />
                      <TextBox Text="{Binding GenerationProfileEditor.SeedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="Seed • provider random"
                               AutomationProperties.Name="Profile random seed" />

                      <ComboBox SelectedIndex="{Binding GenerationProfileEditor.ReasoningModeIndex, Mode=TwoWay}"
                                AutomationProperties.Name="Profile reasoning mode"
                                AutomationProperties.HelpText="Keep the provider default, explicitly disable reasoning, or enable it with a token budget.">
                        <ComboBoxItem Content="Provider default" />
                        <ComboBoxItem Content="Disabled" />
                        <ComboBoxItem Content="Enabled" />
                      </ComboBox>

                      <TextBox Text="{Binding GenerationProfileEditor.ReasoningBudgetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               IsEnabled="{Binding GenerationProfileEditor.IsReasoningBudgetEditable}"
                               PlaceholderText="Reasoning budget tokens • 512 recommended"
                               AutomationProperties.Name="Profile reasoning token budget" />
                    </StackPanel>
                  </Expander>

                  <TextBox Text="{Binding GenerationProfileEditor.InitialSuggestionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="72"
                           PlaceholderText="Initial suggestions • one per line"
                           AutomationProperties.Name="Generation profile initial suggestions" />

                  <TextBlock Text="WorkingDraft changes are autosaved locally after a short pause. Saving a revision confirms an immutable profile revision; during an active response, editing and autosave remain available but revision commits stay disabled."
                             FontSize="12"
                             LineHeight="18"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}" />

                  <WrapPanel Orientation="Horizontal">
                    <Button Classes="secondary-action"
                            Margin="0,0,8,8"
                            Command="{Binding SaveGenerationProfileDraftCommand}"
                            IsEnabled="{Binding CanSaveGenerationProfileDraft}"
                            Content="Save draft now"
                            AutomationProperties.Name="Save generation profile working draft now" />
                    <Button Classes="primary-action"
                            Margin="0,0,8,8"
                            Command="{Binding CommitGenerationProfileCommand}"
                            IsEnabled="{Binding CanCommitGenerationProfile}"
                            Content="Save revision"
                            AutomationProperties.Name="Save confirmed generation profile revision" />
                    <Button Classes="secondary-action"
                            Margin="0,0,8,8"
                            Command="{Binding DiscardGenerationProfileDraftCommand}"
                            IsEnabled="{Binding CanDiscardGenerationProfileDraft}"
                            Content="Discard draft"
                            AutomationProperties.Name="Discard generation profile working draft" />
                    <Button Classes="secondary-action"
                            Margin="0,0,0,8"
                            Command="{Binding CancelGenerationProfileEditCommand}"
                            Content="Close editor"
                            AutomationProperties.Name="Close generation profile editor" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="workspace-secondary-surface"
                  Padding="18"
                  VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Classes="workspace-section-title"
                         Text="Summary"
                         AutomationProperties.HeadingLevel="2" />

              <TextBlock Text="Provider"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding ProviderName}"
                         FontSize="17"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding ProviderStatusText}"
                         FontSize="13"
                         Foreground="{DynamicResource TextSecondaryBrush}" />

              <TextBlock Text="{Binding ProviderConfigurationStatusText}"
                         Margin="0,8,0,0"
                         FontSize="13"
                         LineHeight="20"
                         TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Polite"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="Blank sampling fields keep provider/model defaults. Reasoning is explicit: disabled sends no reasoning request; enabled uses the visible token budget."
                         FontSize="12"
                         LineHeight="18"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
