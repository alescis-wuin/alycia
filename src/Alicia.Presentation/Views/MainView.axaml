<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Alicia.Presentation.Controls"
             xmlns:vm="using:Alicia.Presentation.ViewModels"
             x:Class="Alicia.Presentation.Views.MainView"
             x:DataType="vm:MainViewModel"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             SizeChanged="OnMainViewSizeChanged">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateConversationCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding BeginRenameCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelTransientActionCommand}" />
  </UserControl.KeyBindings>

  <Grid ColumnDefinitions="Auto,*"
        Container.Name="workspace"
        Container.Sizing="Width">
    <Grid.Styles>
      <ContainerQuery Name="workspace" Query="max-width:980">
        <Style Selector="Border.sidebar-shell">
          <Setter Property="Width" Value="260" />
          <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Grid.content-shell">
          <Setter Property="Margin" Value="18" />
        </Style>
      </ContainerQuery>

      <ContainerQuery Name="workspace" Query="max-width:780">
        <Style Selector="Border.sidebar-shell">
          <Setter Property="Width" Value="220" />
          <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Grid.content-shell">
          <Setter Property="Margin" Value="14" />
        </Style>
        <Style Selector="Border.history-row StackPanel.history-actions">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
      </ContainerQuery>
    </Grid.Styles>

    <Border Grid.Column="0"
            Classes="sidebar-shell"
            Width="300"
            Background="{DynamicResource SidebarBrush}"
            BorderThickness="0"
            Padding="14"
            IsVisible="{Binding IsConversationHistoryExpanded}"
            AutomationProperties.Name="Conversation history"
            AutomationProperties.LandmarkType="Navigation"
            AutomationProperties.AccessibilityView="Control">
      <Grid RowDefinitions="Auto,12,Auto,2,*">
        <Grid ColumnDefinitions="36,*,36">
          <Border Grid.Column="0"
                  Width="36"
                  Height="36"
                  Background="Transparent" />

          <TextBlock Grid.Column="1"
                     Text="Conversations"
                     FontSize="16"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     TextAlignment="Center"
                     AutomationProperties.HeadingLevel="2"
                     Foreground="{DynamicResource TextPrimaryBrush}" />

          <Button Grid.Column="2"
                  Classes="history-collapse-action"
                  Command="{Binding ToggleConversationHistoryCommand}"
                  AutomationProperties.Name="Collapse conversation history"
                  AutomationProperties.HelpText="Hide the conversation history panel."
                  ToolTip.Tip="Collapse conversation history">
            <PathIcon Width="18"
                      Height="18"
                      Foreground="{DynamicResource TextSecondaryBrush}"
                      Data="M15.41,7.41 L14,6 L8,12 L14,18 L15.41,16.59 L10.83,12 Z" />
          </Button>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,10,40">
          <TextBox Grid.Column="0"
                   Classes="history-search"
                   Text="{Binding HistorySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                   PlaceholderText="Search conversations"
                   IsEnabled="{Binding IsInteractionEnabled}"
                   AutomationProperties.Name="Search conversations"
                   AutomationProperties.HelpText="Search conversation titles and message content." />

          <Button Grid.Column="2"
                  Classes="create-conversation-action"
                  Command="{Binding CreateConversationCommand}"
                  IsEnabled="{Binding IsInteractionEnabled}"
                  AutomationProperties.Name="Create new conversation"
                  AutomationProperties.HelpText="Create and select a new local conversation."
                  AutomationProperties.AcceleratorKey="Ctrl+N"
                  ToolTip.Tip="Create a new conversation (Ctrl+N)">
            <PathIcon Width="20"
                      Height="20"
                      Foreground="{DynamicResource TextOnAccentBrush}"
                      Data="M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z" />
          </Button>
        </Grid>

        <ProgressBar Grid.Row="3"
                     Height="2"
                     Margin="4,0"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsHistorySearchBusy}"
                     AutomationProperties.Name="Searching conversation history" />

        <Grid Grid.Row="4"
              Margin="0,10,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Conversations}"
                          HorizontalAlignment="Stretch"
                          KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                  <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConversationListItemViewModel">
                  <Border Classes="history-row"
                          MinHeight="54"
                          HorizontalAlignment="Stretch"
                          Classes.selected="{Binding IsSelected}"
                          Classes.editing="{Binding IsRenaming}">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Rename"
                                  Command="{Binding RenameCommand}" />
                        <MenuItem Header="Change icon"
                                  ItemsSource="{Binding IconChoices}">
                          <MenuItem.Styles>
                            <Style Selector="MenuItem"
                                   x:DataType="vm:ConversationIdentityChoiceViewModel">
                              <Setter Property="Header" Value="{Binding Label}" />
                              <Setter Property="Command" Value="{Binding SelectCommand}" />
                              <Setter Property="ToggleType" Value="Radio" />
                              <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                            </Style>
                          </MenuItem.Styles>
                        </MenuItem>
                        <MenuItem Header="Change color"
                                  ItemsSource="{Binding ColorChoices}">
                          <MenuItem.Styles>
                            <Style Selector="MenuItem"
                                   x:DataType="vm:ConversationIdentityChoiceViewModel">
                              <Setter Property="Header" Value="{Binding Label}" />
                              <Setter Property="Command" Value="{Binding SelectCommand}" />
                              <Setter Property="ToggleType" Value="Radio" />
                              <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                            </Style>
                          </MenuItem.Styles>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Delete"
                                  Command="{Binding DeleteCommand}" />
                      </ContextMenu>
                    </Border.ContextMenu>

                    <Grid HorizontalAlignment="Stretch">
                      <Button Classes="history-item"
                              MinHeight="52"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Command="{Binding SelectCommand}"
                              IsVisible="{Binding IsTitleVisible}"
                              PointerEntered="OnConversationPreviewPointerEntered"
                              ToolTip.Placement="RightEdgeAlignedTop"
                              ToolTip.ShowDelay="350"
                              ToolTip.BetweenShowDelay="-1"
                              ToolTip.HorizontalOffset="12"
                              AutomationProperties.Name="{Binding SelectionAutomationName}"
                              AutomationProperties.HelpText="Open this conversation. Hover for a short preview or use the actions menu."
                              AutomationProperties.ItemStatus="{Binding MetadataLabel}">
                        <ToolTip.Tip>
                          <Border Classes="history-preview-card"
                                  Width="360"
                                  Padding="14">
                            <StackPanel Spacing="10">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="15"
                                         FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />

                              <ItemsControl ItemsSource="{Binding PreviewMessages}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ConversationPreviewMessageViewModel">
                                    <StackPanel Spacing="3"
                                                Margin="0,0,0,7">
                                      <TextBlock Text="{Binding RoleLabel}"
                                                 FontSize="11"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource AccentSecondaryBrush}" />
                                      <TextBlock Text="{Binding Content}"
                                                 FontSize="13"
                                                 MaxLines="3"
                                                 TextWrapping="Wrap"
                                                 TextTrimming="CharacterEllipsis"
                                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>

                              <TextBlock Text="{Binding PreviewStatusText}"
                                         IsVisible="{Binding HasPreviewStatusText}"
                                         FontSize="12"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                          </Border>
                        </ToolTip.Tip>

                        <Grid ColumnDefinitions="5,10,34,10,*"
                              HorizontalAlignment="Stretch">
                          <Border Grid.Column="0"
                                  Margin="0,9,0,9"
                                  CornerRadius="3"
                                  Background="{Binding IdentityColorBrush}"
                                  IsVisible="{Binding IsSelected}" />

                          <Border Grid.Column="2"
                                  Classes="conversation-identity"
                                  Width="34"
                                  Height="34"
                                  Background="{Binding IdentitySurfaceBrush}"
                                  BorderBrush="{Binding IdentityColorBrush}"
                                  AutomationProperties.Name="{Binding IdentityDescription}"
                                  ToolTip.Tip="{Binding IdentityDescription}">
                            <TextBlock Text="{Binding IdentityGlyph}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding IdentityColorBrush}" />
                          </Border>

                          <TextBlock Grid.Column="4"
                                     Margin="0,0,48,0"
                                     Text="{Binding Title}"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                      </Button>

                      <StackPanel Classes="history-actions"
                                  Orientation="Horizontal"
                                  Margin="0,0,10,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsTitleVisible}">
                        <Button Classes="history-action"
                                Content="⋯"
                                FontSize="19"
                                AutomationProperties.Name="Conversation actions"
                                AutomationProperties.HelpText="Open actions for this conversation."
                                ToolTip.Tip="Conversation actions">
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                              <MenuItem Header="Rename"
                                        Command="{Binding RenameCommand}" />
                              <MenuItem Header="Change icon"
                                        ItemsSource="{Binding IconChoices}">
                                <MenuItem.Styles>
                                  <Style Selector="MenuItem"
                                         x:DataType="vm:ConversationIdentityChoiceViewModel">
                                    <Setter Property="Header" Value="{Binding Label}" />
                                    <Setter Property="Command" Value="{Binding SelectCommand}" />
                                    <Setter Property="ToggleType" Value="Radio" />
                                    <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                  </Style>
                                </MenuItem.Styles>
                              </MenuItem>
                              <MenuItem Header="Change color"
                                        ItemsSource="{Binding ColorChoices}">
                                <MenuItem.Styles>
                                  <Style Selector="MenuItem"
                                         x:DataType="vm:ConversationIdentityChoiceViewModel">
                                    <Setter Property="Header" Value="{Binding Label}" />
                                    <Setter Property="Command" Value="{Binding SelectCommand}" />
                                    <Setter Property="ToggleType" Value="Radio" />
                                    <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                  </Style>
                                </MenuItem.Styles>
                              </MenuItem>
                              <Separator />
                              <MenuItem Header="Delete"
                                        Command="{Binding DeleteCommand}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>

                      <Grid ColumnDefinitions="5,10,34,10,*,Auto,Auto"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsRenaming}">
                        <Border Grid.Column="0"
                                Margin="0,8,0,8"
                                CornerRadius="3"
                                Background="{DynamicResource EditBrush}" />

                        <Border Grid.Column="2"
                                Classes="conversation-identity"
                                Width="34"
                                Height="34"
                                Background="{Binding IdentitySurfaceBrush}"
                                BorderBrush="{Binding IdentityColorBrush}"
                                ToolTip.Tip="{Binding IdentityDescription}">
                          <TextBlock Text="{Binding IdentityGlyph}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{Binding IdentityColorBrush}" />
                        </Border>

                        <controls:InlineRenameTextBox Grid.Column="4"
                                                      Classes="inline-rename"
                                                      Margin="0,7,8,7"
                                                      Text="{Binding RenameTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      MaxLength="120"
                                                      AutomationProperties.Name="{Binding RenameInputAutomationName}"
                                                      AutomationProperties.HelpText="Type a new title. Press Enter to save or Escape to cancel."
                                                      ToolTip.Tip="{Binding RenameInputToolTip}">
                          <controls:InlineRenameTextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SaveRenameCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                          </controls:InlineRenameTextBox.KeyBindings>
                        </controls:InlineRenameTextBox>

                        <Button Grid.Column="5"
                                Classes="history-action save-history-action"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Command="{Binding SaveRenameCommand}"
                                IsEnabled="{Binding CanSaveRename}"
                                AutomationProperties.Name="{Binding SaveRenameAutomationName}"
                                AutomationProperties.HelpText="Save the edited title."
                                AutomationProperties.AcceleratorKey="Enter"
                                ToolTip.Tip="Save title (Enter)">
                          <PathIcon Width="17"
                                    Height="17"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z" />
                        </Button>

                        <Button Grid.Column="6"
                                Classes="history-action"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Command="{Binding CancelRenameCommand}"
                                AutomationProperties.Name="{Binding CancelRenameAutomationName}"
                                AutomationProperties.HelpText="Cancel title editing."
                                AutomationProperties.AcceleratorKey="Escape"
                                ToolTip.Tip="Cancel rename (Escape)">
                          <PathIcon Width="17"
                                    Height="17"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Data="M18.3,5.71 L12,12 L5.7,5.71 L4.29,7.12 L10.59,13.41 L4.29,19.71 L5.7,21.12 L12,14.83 L18.3,21.12 L19.71,19.71 L13.41,13.41 L19.71,7.12 Z" />
                        </Button>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Classes="surface"
                  Padding="14"
                  VerticalAlignment="Top"
                  IsVisible="{Binding IsHistoryEmpty}">
            <TextBlock Text="No conversations yet"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>

          <Border Classes="surface"
                  Padding="14"
                  VerticalAlignment="Top"
                  IsVisible="{Binding ShowNoHistorySearchResults}">
            <StackPanel Spacing="4">
              <TextBlock Text="No matching conversations"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Try another title or a phrase from a message."
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Button Grid.Column="1"
            Classes="history-reopen-action"
            Width="34"
            Height="42"
            MinWidth="34"
            MinHeight="42"
            Margin="8,18,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            ZIndex="20"
            IsVisible="{Binding IsConversationHistoryCollapsed}"
            Command="{Binding ToggleConversationHistoryCommand}"
            AutomationProperties.Name="Show conversation history"
            AutomationProperties.HelpText="Show the hidden conversation history panel."
            ToolTip.Tip="Show conversation history">
      <PathIcon Width="18"
                Height="18"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Data="M8.59,16.59 L10,18 L16,12 L10,6 L8.59,7.41 L13.17,12 Z" />
    </Button>

    <Grid Grid.Column="1"
          Classes="content-shell"
          RowDefinitions="Auto,*"
          Margin="28"
          AutomationProperties.Name="Conversation workspace"
          AutomationProperties.LandmarkType="Main"
          AutomationProperties.AccessibilityView="Control">
      <Border Grid.Row="0"
              Classes="surface"
              Padding="16"
              Margin="0,0,0,16"
              IsVisible="{Binding HasError}"
              AutomationProperties.Name="Error notification">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Something needs attention"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="secondary-action"
                  Command="{Binding DismissErrorCommand}"
                  Content="Dismiss"
                  AutomationProperties.Name="Dismiss error notification"
                  ToolTip.Tip="Dismiss this error" />
        </Grid>
      </Border>


      <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Row="0"
                Background="{DynamicResource DangerSurfaceBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Margin="0,0,0,14"
                IsVisible="{Binding IsDeleteConfirmationVisible}"
                AutomationProperties.Name="Delete conversation confirmation"
                AutomationProperties.LiveSetting="Assertive">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="Delete conversation?"
                         FontWeight="Bold"
                         Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Text="{Binding DeletePrompt}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="This permanently removes the local conversation file. This action cannot be undone."
                         FontSize="13"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    Classes="danger-action"
                    Command="{Binding ConfirmDeleteCommand}"
                    Content="Confirm delete"
                    AutomationProperties.Name="Permanently delete selected conversation"
                    AutomationProperties.HelpText="This permanently removes the local conversation file and cannot be undone."
                    ToolTip.Tip="Permanently delete this conversation" />
            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    Classes="secondary-action"
                    Command="{Binding CancelDeleteCommand}"
                    Content="Cancel"
                    AutomationProperties.Name="Keep selected conversation"
                    ToolTip.Tip="Cancel deletion (Escape)" />
          </Grid>
        </Border>

        <Border Grid.Row="1"
                Classes="conversation-thread-shell"
                Padding="12,16,0,16">
          <Grid>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        IsVisible="{Binding ShowLoadingState}">
              <ProgressBar Width="220" IsIndeterminate="True" />
              <TextBlock Text="Loading local history…"
                         FontSize="20"
                         FontWeight="SemiBold"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Alicia is reading the conversations stored on this device."
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14"
                        MaxWidth="560"
                        IsVisible="{Binding IsHistoryEmpty}">
              <Border Width="72"
                      Height="72"
                      CornerRadius="22"
                      Background="{DynamicResource AccentBrush}"
                      HorizontalAlignment="Center">
                <TextBlock Text="A"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextOnAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Start a conversation"
                         FontSize="28"
                         FontWeight="Bold"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Create a local conversation here. Provider and model setup live in the global Provider and Models workspaces."
                         FontSize="16"
                         LineHeight="24"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <Button Classes="primary-action"
                      Command="{Binding CreateConversationCommand}"
                      HorizontalAlignment="Center"
                      Content="Create conversation"
                      AutomationProperties.Name="Create first conversation"
                      ToolTip.Tip="Create a new local conversation (Ctrl+N)" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        IsVisible="{Binding ShowNoSelectionState}">
              <TextBlock Text="Select a conversation"
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Choose an item from the history sidebar."
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="560"
                        IsVisible="{Binding IsSelectedConversationEmpty}">
              <TextBlock Text="This conversation is empty"
                         FontSize="26"
                         FontWeight="Bold"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Write the first message below. It is stored locally before Alicia starts the streamed local-model response."
                         FontSize="16"
                         LineHeight="24"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer x:Name="MessagesScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding HasMessages}"
                          ScrollChanged="OnMessagesScrollChanged">
              <ItemsControl ItemsSource="{Binding Messages}"
                            Margin="0,0,18,0"
                            AutomationProperties.Name="Conversation messages"
                            AutomationProperties.LiveSetting="Polite">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MessageViewModel">
                    <Border Classes="message-bubble"
                            Classes.user-message="{Binding IsUser}"
                            Classes.assistant-message="{Binding IsAssistant}"
                            Classes.system-message="{Binding IsSystem}"
                            AutomationProperties.Name="{Binding AutomationName}">
                      <StackPanel Spacing="10">
                        <TextBlock Text="{Binding ThinkingIndicatorText}"
                                   IsVisible="{Binding IsWaitingForFirstDelta}"
                                   Classes="thinking-indicator"
                                   FontSize="14"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Expander Header="{Binding ReasoningHeader}"
                                  IsVisible="{Binding HasReasoning}"
                                  IsExpanded="{Binding IsReasoningExpanded, Mode=TwoWay}"
                                  Classes="reasoning-expander"
                                  AutomationProperties.Name="Model reasoning">
                          <ItemsControl ItemsSource="{Binding ReasoningSteps}"
                                        Margin="0,8,0,2">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ReasoningStepViewModel">
                                <Border Classes="reasoning-step">
                                  <TextBlock Text="{Binding Content}"
                                             FontSize="13"
                                             LineHeight="19"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Expander>

                        <TextBlock Text="{Binding Content}"
                                   IsVisible="{Binding HasContent}"
                                   FontSize="16"
                                   LineHeight="24"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

          </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,8,0,0"
              HorizontalAlignment="Center"
              IsVisible="{Binding HasMessages}"
              ZIndex="30">
          <Button Classes="conversation-follow-action"
                  IsVisible="{Binding ShowPauseAutoScrollButton}"
                  Command="{Binding PauseAutoScrollCommand}"
                  AutomationProperties.Name="Pause automatic scrolling"
                  AutomationProperties.HelpText="Stop following new streamed content without moving the current viewport."
                  ToolTip.Tip="Pause auto-scroll and keep this reading position">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="18"
                        Height="18"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Data="M6.7,14.7 L12,9.4 L17.3,14.7 L15.9,16.1 L12,12.2 L8.1,16.1 Z" />
              <TextBlock Text="Pause auto-scroll"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>

          <Button Classes="conversation-follow-action"
                  IsVisible="{Binding ShowScrollToLatestButton}"
                  Command="{Binding ScrollToLatestCommand}"
                  AutomationProperties.Name="Resume automatic scrolling and go to latest message"
                  AutomationProperties.HelpText="Resume following streamed content and move the viewport to the latest conversation content."
                  ToolTip.Tip="Resume auto-scroll and jump to the latest message">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="18"
                        Height="18"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Data="M6.7,9.3 L12,14.6 L17.3,9.3 L15.9,7.9 L12,11.8 L8.1,7.9 Z" />
              <TextBlock Text="Resume &amp; jump to latest"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Grid.Row="3"
                Classes="message-composer-shell"
                Margin="0,14,0,0"
                IsVisible="{Binding HasSelectedConversation}"
                Cursor="Ibeam"
                PointerPressed="OnMessageComposerShellPointerPressed"
                AutomationProperties.Name="Message composer"
                AutomationProperties.HelpText="Write a user message. Enter sends; Shift+Enter inserts a new line. Stop cancels the active streamed response.">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="MessageComposer"
                     Grid.Column="0"
                     Classes="message-composer"
                     Text="{Binding MessageDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding ComposerPlaceholder}"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="Wrap"
                     IsEnabled="{Binding IsComposerEnabled}"
                     KeyDown="OnMessageComposerKeyDown"
                     AutomationProperties.Name="Message text"
                     AutomationProperties.HelpText="Type a user message. Press Enter to send or Shift+Enter for a new line."
                     AutomationProperties.AcceleratorKey="Enter"
                     ToolTip.Tip="Enter sends • Shift+Enter adds a new line" />

            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="8">
              <Button Classes="send-action"
                      IsEnabled="{Binding CanSendMessage}"
                      Click="OnSendMessageClick"
                      AutomationProperties.Name="Send message"
                      AutomationProperties.HelpText="Persist this user message and start an Alicia streamed response."
                      AutomationProperties.AcceleratorKey="Enter"
                      ToolTip.Tip="Send message (Enter)">
                <PathIcon Width="22"
                          Height="22"
                          Foreground="{DynamicResource TextOnAccentBrush}"
                          Data="M7,5 L20,12 L7,19 Z" />
              </Button>
              <Button Classes="secondary-action composer-secondary-action"
                      Command="{Binding StopResponseCommand}"
                      IsVisible="{Binding IsGeneratingResponse}"
                      IsEnabled="{Binding CanStopResponse}"
                      Content="Stop"
                      AutomationProperties.Name="Stop Alicia response"
                      AutomationProperties.HelpText="Cancel the active streamed response without removing the user message or saving partial output."
                      AutomationProperties.AcceleratorKey="Escape"
                      ToolTip.Tip="Stop response (Escape)" />
              <Button Classes="secondary-action composer-secondary-action"
                      Command="{Binding RetryResponseCommand}"
                      IsVisible="{Binding CanRetryResponse}"
                      IsEnabled="{Binding CanRetryResponse}"
                      Content="Retry response"
                      AutomationProperties.Name="Retry Alicia response"
                      AutomationProperties.HelpText="Generate another response for the existing unanswered user message."
                      ToolTip.Tip="Retry response without resending your message" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
