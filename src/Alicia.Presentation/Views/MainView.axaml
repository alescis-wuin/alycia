<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Alicia.Presentation.Controls"
             xmlns:vm="using:Alicia.Presentation.ViewModels"
             x:Class="Alicia.Presentation.Views.MainView"
             x:DataType="vm:MainViewModel"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateConversationCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding BeginRenameCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelTransientActionCommand}" />
  </UserControl.KeyBindings>

  <Grid ColumnDefinitions="Auto,*"
        Container.Name="workspace"
        Container.Sizing="Width">
    <Grid.Styles>
      <ContainerQuery Name="workspace" Query="max-width:980">
        <Style Selector="Border.sidebar-shell">
          <Setter Property="Width" Value="250" />
          <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Grid.content-shell">
          <Setter Property="Margin" Value="18" />
        </Style>
        <Style Selector="TextBlock.brand-title">
          <Setter Property="FontSize" Value="26" />
        </Style>
      </ContainerQuery>

      <ContainerQuery Name="workspace" Query="max-width:780">
        <Style Selector="Border.sidebar-shell">
          <Setter Property="Width" Value="220" />
          <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Grid.content-shell">
          <Setter Property="Margin" Value="14" />
        </Style>
        <Style Selector="TextBlock.brand-title">
          <Setter Property="FontSize" Value="23" />
        </Style>
        <Style Selector="TextBlock.brand-subtitle">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TextBlock.history-meta">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TextBlock.sidebar-shortcuts">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.history-row StackPanel.history-actions">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
      </ContainerQuery>
    </Grid.Styles>

    <Border Grid.Column="0"
            Classes="sidebar-shell"
            Width="300"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="20"
            AutomationProperties.Name="Conversation history"
            AutomationProperties.LandmarkType="Navigation"
            AutomationProperties.AccessibilityView="Control">
      <Grid RowDefinitions="Auto,18,Auto,18,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Classes="brand-title"
                       Text="{Binding ApplicationName}"
                       FontSize="30"
                       AutomationProperties.HeadingLevel="1"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Classes="brand-subtitle"
                       Text="LOCAL CONVERSATIONS"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentSecondaryBrush}" />
          </StackPanel>

          <Button Grid.Column="1"
                  Classes="secondary-action"
                  Command="{Binding RefreshCommand}"
                  IsEnabled="{Binding IsInteractionEnabled}"
                  Content="Refresh"
                  AutomationProperties.Name="Refresh conversation history"
                  AutomationProperties.HelpText="Reload conversations stored on this device."
                  AutomationProperties.AcceleratorKey="F5"
                  ToolTip.Tip="Refresh local conversation history (F5)" />
        </Grid>

        <Button Grid.Row="2"
                Classes="primary-action"
                Command="{Binding CreateConversationCommand}"
                IsEnabled="{Binding IsInteractionEnabled}"
                Content="+ New conversation"
                AutomationProperties.Name="Create new conversation"
                AutomationProperties.HelpText="Create and select a new local conversation."
                AutomationProperties.AcceleratorKey="Ctrl+N"
                ToolTip.Tip="Create a new local conversation (Ctrl+N)" />

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
          <TextBlock Text="History"
                     FontSize="15"
                     AutomationProperties.HeadingLevel="2"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center" />
          <Border Grid.Column="1" Classes="status-chip">
            <TextBlock Text="{Binding Conversations.Count}"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>
        </Grid>

        <Grid Grid.Row="5" Margin="0,12,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Conversations}"
                          KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConversationListItemViewModel">
                  <Border Classes="history-row"
                          Classes.selected="{Binding IsSelected}"
                          Classes.editing="{Binding IsRenaming}">
                    <Grid>
                      <Button Classes="history-item"
                              Command="{Binding SelectCommand}"
                              IsVisible="{Binding IsTitleVisible}"
                              AutomationProperties.Name="{Binding SelectionAutomationName}"
                              AutomationProperties.HelpText="Open this conversation. Hover or focus the row for rename and delete actions."
                              AutomationProperties.ItemStatus="{Binding MetadataLabel}"
                              ToolTip.Tip="{Binding SelectionToolTip}">
                        <Grid ColumnDefinitions="5,12,*" Margin="0">
                          <Border Grid.Column="0"
                                  Margin="0,10,0,10"
                                  CornerRadius="3"
                                  Background="{DynamicResource AccentSecondaryBrush}"
                                  IsVisible="{Binding IsSelected}" />

                          <StackPanel Grid.Column="2"
                                      Margin="0,10,88,10"
                                      Spacing="5">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Title}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Classes="history-meta"
                                       Text="{Binding MetadataLabel}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                          </StackPanel>
                        </Grid>
                      </Button>

                      <StackPanel Classes="history-actions"
                                  Orientation="Horizontal"
                                  Spacing="6"
                                  Margin="0,0,10,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsTitleVisible}">
                        <Button Classes="history-action edit-history-action"
                                Command="{Binding RenameCommand}"
                                AutomationProperties.Name="{Binding RenameAutomationName}"
                                AutomationProperties.HelpText="Edit the title inline. Enter saves the new title; Escape cancels."
                                ToolTip.Tip="{Binding RenameToolTip}">
                          <PathIcon Width="17"
                                    Height="17"
                                    Foreground="{DynamicResource EditBrush}"
                                    Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 L3,17.25 M20.71,7.04 C21.1,6.65 21.1,6 20.71,5.63 L18.37,3.29 C18,2.9 17.35,2.9 16.96,3.29 L15.12,5.12 L18.87,8.87 L20.71,7.04 Z" />
                        </Button>
                        <Button Classes="history-action delete-history-action"
                                Command="{Binding DeleteCommand}"
                                AutomationProperties.Name="{Binding DeleteAutomationName}"
                                AutomationProperties.HelpText="Open a confirmation before permanently deleting this local conversation."
                                ToolTip.Tip="{Binding DeleteToolTip}">
                          <PathIcon Width="17"
                                    Height="17"
                                    Foreground="{DynamicResource DangerBrush}"
                                    Data="M6,19 C6,20.1 6.9,21 8,21 H16 C17.1,21 18,20.1 18,19 V7 H6 V19 M8,9 H16 V19 H8 V9 M15.5,4 L14.5,3 H9.5 L8.5,4 H5 V6 H19 V4 H15.5 Z" />
                        </Button>
                      </StackPanel>

                      <Grid ColumnDefinitions="5,12,*,Auto,Auto"
                            IsVisible="{Binding IsRenaming}">
                        <Border Grid.Column="0"
                                Margin="0,10,0,10"
                                CornerRadius="3"
                                Background="{DynamicResource EditBrush}" />

                        <controls:InlineRenameTextBox Grid.Column="2"
                                                      Classes="inline-rename"
                                                      Margin="0,10,8,10"
                                                      Text="{Binding RenameTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      MaxLength="120"
                                                      AutomationProperties.Name="{Binding RenameInputAutomationName}"
                                                      AutomationProperties.HelpText="Type a new conversation title. The current title is selected automatically. Press Enter to save or Escape to cancel."
                                                      ToolTip.Tip="{Binding RenameInputToolTip}">
                          <controls:InlineRenameTextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SaveRenameCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                          </controls:InlineRenameTextBox.KeyBindings>
                        </controls:InlineRenameTextBox>

                        <Button Grid.Column="3"
                                Classes="history-action save-history-action"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Command="{Binding SaveRenameCommand}"
                                IsEnabled="{Binding CanSaveRename}"
                                AutomationProperties.Name="{Binding SaveRenameAutomationName}"
                                AutomationProperties.HelpText="Save the edited title. The same action is available with Enter."
                                AutomationProperties.AcceleratorKey="Enter"
                                ToolTip.Tip="Save title (Enter)">
                          <PathIcon Width="17"
                                    Height="17"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z" />
                        </Button>

                        <Button Grid.Column="4"
                                Classes="history-action"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Command="{Binding CancelRenameCommand}"
                                AutomationProperties.Name="{Binding CancelRenameAutomationName}"
                                AutomationProperties.HelpText="Cancel title editing and restore the previous title. The same action is available with Escape."
                                AutomationProperties.AcceleratorKey="Escape"
                                ToolTip.Tip="Cancel rename (Escape)">
                          <PathIcon Width="17"
                                    Height="17"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Data="M18.3,5.71 L12,12 L5.7,5.71 L4.29,7.12 L10.59,13.41 L4.29,19.71 L5.7,21.12 L12,14.83 L18.3,21.12 L19.71,19.71 L13.41,13.41 L19.71,7.12 Z" />
                        </Button>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Classes="surface"
                  Padding="18"
                  VerticalAlignment="Top"
                  IsVisible="{Binding IsHistoryEmpty}">
            <StackPanel Spacing="7">
              <TextBlock Text="No conversations yet"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Create one to start building your local conversation history."
                         FontSize="13"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel Grid.Row="6" Margin="0,12,0,0" Spacing="7">
          <ProgressBar Height="3"
                       IsIndeterminate="True"
                       IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding StatusText}"
                     FontSize="12"
                     AutomationProperties.LiveSetting="Polite"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Classes="sidebar-shortcuts"
                     Text="Ctrl+N new • F5 refresh • F2 rename • Esc cancel"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1"
          Classes="content-shell"
          RowDefinitions="Auto,Auto,*"
          Margin="28"
          AutomationProperties.Name="Conversation workspace"
          AutomationProperties.LandmarkType="Main"
          AutomationProperties.AccessibilityView="Control">
      <Border Grid.Row="0"
              Classes="surface"
              Padding="16"
              Margin="0,0,0,16"
              IsVisible="{Binding HasError}"
              AutomationProperties.Name="Error notification">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Something needs attention"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="secondary-action"
                  Command="{Binding DismissErrorCommand}"
                  Content="Dismiss"
                  AutomationProperties.Name="Dismiss error notification"
                  ToolTip.Tip="Dismiss this error" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="2,0,2,18" Spacing="4">
        <TextBlock Text="{Binding SelectedConversationTitle}"
                   FontSize="24"
                   AutomationProperties.HeadingLevel="2"
                   FontWeight="Bold"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding SelectedConversationTitle}"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding SelectedConversationMeta}"
                   FontSize="14"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>

      <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Background="{DynamicResource DangerSurfaceBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Margin="0,0,0,14"
                IsVisible="{Binding IsDeleteConfirmationVisible}"
                AutomationProperties.Name="Delete conversation confirmation"
                AutomationProperties.LiveSetting="Assertive">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="Delete conversation?"
                         FontWeight="Bold"
                         Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Text="{Binding DeletePrompt}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="This permanently removes the local conversation file. This action cannot be undone."
                         FontSize="13"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    Classes="danger-action"
                    Command="{Binding ConfirmDeleteCommand}"
                    Content="Confirm delete"
                    AutomationProperties.Name="Permanently delete selected conversation"
                    AutomationProperties.HelpText="This permanently removes the local conversation file and cannot be undone."
                    ToolTip.Tip="Permanently delete this conversation" />
            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    Classes="secondary-action"
                    Command="{Binding CancelDeleteCommand}"
                    Content="Cancel"
                    AutomationProperties.Name="Keep selected conversation"
                    ToolTip.Tip="Cancel deletion (Escape)" />
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="surface" Padding="22">
          <Grid>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        IsVisible="{Binding ShowLoadingState}">
              <ProgressBar Width="220" IsIndeterminate="True" />
              <TextBlock Text="Loading local history…"
                         FontSize="20"
                         FontWeight="SemiBold"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Alicia is reading the conversations stored on this device."
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14"
                        MaxWidth="560"
                        IsVisible="{Binding IsHistoryEmpty}">
              <Border Width="72"
                      Height="72"
                      CornerRadius="22"
                      Background="{DynamicResource AccentBrush}"
                      HorizontalAlignment="Center">
                <TextBlock Text="A"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextOnAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Start your first conversation"
                         FontSize="28"
                         FontWeight="Bold"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Create a local conversation and send a message. Alicia currently answers through a local development responder."
                         FontSize="16"
                         LineHeight="24"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <Button Classes="primary-action"
                      Command="{Binding CreateConversationCommand}"
                      HorizontalAlignment="Center"
                      Content="Create conversation"
                      AutomationProperties.Name="Create first conversation"
                      ToolTip.Tip="Create a new local conversation (Ctrl+N)" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        IsVisible="{Binding ShowNoSelectionState}">
              <TextBlock Text="Select a conversation"
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Choose an item from the history sidebar."
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="560"
                        IsVisible="{Binding IsSelectedConversationEmpty}">
              <TextBlock Text="This conversation is empty"
                         FontSize="26"
                         FontWeight="Bold"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Write the first message below. It is stored locally before Alicia starts a streamed development response."
                         FontSize="16"
                         LineHeight="24"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer x:Name="MessagesScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding HasMessages}">
              <ItemsControl ItemsSource="{Binding Messages}"
                            AutomationProperties.Name="Conversation messages"
                            AutomationProperties.LiveSetting="Polite">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MessageViewModel">
                    <Border Classes="message-bubble"
                            Classes.user-message="{Binding IsUser}"
                            Classes.assistant-message="{Binding IsAssistant}"
                            Classes.system-message="{Binding IsSystem}"
                            AutomationProperties.Name="{Binding AutomationName}">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="message-role"
                                     Classes.user-message-role="{Binding IsUser}"
                                     Classes.assistant-message-role="{Binding IsAssistant}"
                                     Classes.system-message-role="{Binding IsSystem}"
                                     Text="{Binding RoleLabel}"
                                     FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding CreatedAtLabel}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding Content}"
                                   FontSize="16"
                                   LineHeight="24"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Row="2"
                Classes="message-composer-shell"
                Margin="0,14,0,0"
                IsVisible="{Binding HasSelectedConversation}"
                AutomationProperties.Name="Message composer"
                AutomationProperties.HelpText="Write a user message. Enter sends; Shift+Enter inserts a new line. Stop cancels the active streamed response.">
          <Grid RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,Auto">
            <TextBox x:Name="MessageComposer"
                     Grid.Column="0"
                     Classes="message-composer"
                     Text="{Binding MessageDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding ComposerPlaceholder}"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="Wrap"
                     IsEnabled="{Binding IsComposerEnabled}"
                     KeyDown="OnMessageComposerKeyDown"
                     AutomationProperties.Name="Message text"
                     AutomationProperties.HelpText="Type a user message. Press Enter to send or Shift+Enter for a new line."
                     AutomationProperties.AcceleratorKey="Enter"
                     ToolTip.Tip="Enter sends • Shift+Enter adds a new line" />

            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="8">
              <Button Classes="send-action"
                      IsEnabled="{Binding CanSendMessage}"
                      Content="{Binding SendButtonLabel}"
                      Click="OnSendMessageClick"
                      AutomationProperties.Name="Send message"
                      AutomationProperties.HelpText="Persist this user message and start an Alicia streamed response."
                      AutomationProperties.AcceleratorKey="Enter"
                      ToolTip.Tip="Send message (Enter)" />
              <Button Classes="secondary-action"
                      Command="{Binding StopResponseCommand}"
                      IsVisible="{Binding IsGeneratingResponse}"
                      IsEnabled="{Binding CanStopResponse}"
                      Content="Stop"
                      AutomationProperties.Name="Stop Alicia response"
                      AutomationProperties.HelpText="Cancel the active streamed response without removing the user message or saving partial output."
                      AutomationProperties.AcceleratorKey="Escape"
                      ToolTip.Tip="Stop response (Escape)" />
              <Button Classes="secondary-action"
                      Command="{Binding RetryResponseCommand}"
                      IsVisible="{Binding CanRetryResponse}"
                      IsEnabled="{Binding CanRetryResponse}"
                      Content="Retry response"
                      AutomationProperties.Name="Retry Alicia response"
                      AutomationProperties.HelpText="Generate another response for the existing unanswered user message."
                      ToolTip.Tip="Retry response without resending your message" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Margin="4,8,4,0"
                       Text="{Binding ComposerStatusText}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
