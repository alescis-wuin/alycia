<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alicia.Presentation.ViewModels"
             x:Class="Alicia.Presentation.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="260,*">
    <Border Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="22">
      <Grid RowDefinitions="Auto,32,Auto,*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding ApplicationName}"
                     FontSize="30"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="AI CHAT"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentSecondaryBrush}" />
        </StackPanel>

        <Button Grid.Row="2"
                Classes="primary-action"
                Content="New conversation"
                IsEnabled="False"
                ToolTip.Tip="Conversation creation will be implemented in a later feature package." />

        <StackPanel Grid.Row="4" Spacing="9">
          <TextBlock Text="FOUNDATION"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="Avalonia desktop host"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="Windows · Linux · macOS"
                     FontSize="14"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="32">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Headline}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="Minimal, accessible, provider-agnostic foundation"
                     FontSize="14"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Column="1" Classes="status-chip" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource SuccessBrush}" />
            <TextBlock Text="{Binding FoundationStatus}"
                       FontSize="14"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Classes="surface"
              MaxWidth="760"
              Padding="44"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="18" HorizontalAlignment="Center">
          <Border Width="72"
                  Height="72"
                  CornerRadius="22"
                  Background="{DynamicResource AccentBrush}"
                  HorizontalAlignment="Center">
            <TextBlock Text="A"
                       FontSize="38"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextOnAccentBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>

          <TextBlock Text="Alicia"
                     FontSize="40"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextAlignment="Center" />

          <TextBlock Text="The repository, architecture, validation tooling, and shared Avalonia UI shell are ready."
                     MaxWidth="620"
                     FontSize="18"
                     LineHeight="28"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />

          <Border Classes="status-chip" HorizontalAlignment="Center">
            <TextBlock Text="{Binding ProviderStatus}"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="2"
                 Text="The next feature package can introduce the conversation domain and AI provider abstraction."
                 FontSize="14"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 HorizontalAlignment="Center"
                 TextWrapping="Wrap"
                 TextAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
