<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alicia.Presentation.ViewModels"
             x:Class="Alicia.Presentation.Views.GenerationDualSelectorView"
             x:DataType="vm:MainViewModel"
             KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="Model and generation profile selector"
             AutomationProperties.HelpText="{Binding GenerationDualSelector.PreviewStatusText}">
  <UserControl.Styles>
    <Style Selector="Button.selector-icon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.selector-icon:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.selector-icon.confirm">
      <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>
  <Border Classes="surface" Padding="10"
          AutomationProperties.Name="Branch model and profile selection panel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
      <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Models" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <Button Classes="selector-icon" Click="OnInformationButtonClick"
                  AutomationProperties.Name="About model selection"
                  ToolTip.Tip="Saved models and compatibility entries. Downloading alone does not add a library entry. If this list is empty, save a model in Models. Choosing here never loads a model or changes provider settings.">
            <PathIcon Width="16" Height="16" Data="M12,4 C8,4 6,6 6,9 L9,9 C9,7.5 10,6.5 12,6.5 C14,6.5 15,7.5 15,9 C15,10 14,10.5 13,11 C11,12 10.5,13 10.5,16 L13,16 C13,14 13.5,13.5 15,12.5 C17,11.5 18,10 18,8.5 C18,5.5 15.5,4 12,4 Z M10.5,18 L13,18 L13,20.5 L10.5,20.5 Z" />
          </Button>
        </StackPanel>
        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
          <TextBlock Text="Profiles" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <Button Grid.Column="1" Classes="selector-icon" Click="OnInformationButtonClick"
                  AutomationProperties.Name="About profile selection"
                  ToolTip.Tip="Confirmed profiles for the selected model. The branch icon marks the effective choice. A local draft stays separate until the pre-send choice. Use the green check to confirm this branch pair.">
            <PathIcon Width="16" Height="16" Data="M12,4 C8,4 6,6 6,9 L9,9 C9,7.5 10,6.5 12,6.5 C14,6.5 15,7.5 15,9 C15,10 14,10.5 13,11 C11,12 10.5,13 10.5,16 L13,16 C13,14 13.5,13.5 15,12.5 C17,11.5 18,10 18,8.5 C18,5.5 15.5,4 12,4 Z M10.5,18 L13,18 L13,20.5 L10.5,20.5 Z" />
          </Button>
          <Button x:Name="CloseButton" Grid.Column="3" Classes="selector-icon"
                  Command="{Binding CancelGenerationDualSelectorCommand}"
                  AutomationProperties.Name="Close model and profile selector"
                  ToolTip.Tip="Close without applying (Escape)">
            <PathIcon Width="16" Height="16" Data="M5,3 L12,10 L19,3 L21,5 L14,12 L21,19 L19,21 L12,14 L5,21 L3,19 L10,12 L3,5 Z" />
          </Button>
        </Grid>
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
        <ListBox x:Name="ModelList" Focusable="True" MaxHeight="220"
                 ItemsSource="{Binding GenerationDualSelector.Models}"
                 SelectedItem="{Binding GenerationDualSelector.SelectedModel, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Saved models"
                 AutomationProperties.HelpText="Use arrow keys to preview a model. Its tooltip provides the full reference and status.">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GenerationDualSelectorModelItemViewModel">
              <StackPanel Margin="4,4" Spacing="3">
                <ToolTip.Tip>
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding ModelReference}" />
                    <TextBlock Text="{Binding ProviderId}" />
                    <TextBlock Text="{Binding StateText}" />
                  </StackPanel>
                </ToolTip.Tip>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <PathIcon Grid.Column="1" Width="14" Height="14"
                            IsVisible="{Binding IsBoundToActiveBranch}"
                            Foreground="{DynamicResource SuccessBrush}"
                            AutomationProperties.Name="Model used by active branch"
                            ToolTip.Tip="Used by this branch"
                            Data="M4,2 L8,2 L8,6 L4,6 Z M5,6 L7,6 L7,10 C7,12 9,13 12,13 L16,13 L16,10 L20,10 L20,14 L18,14 L18,20 L14,20 L14,16 L16,16 L16,15 L12,15 C10,15 8,14 7,13 L7,20 L5,20 Z" />
                </Grid>
                <TextBlock Text="{Binding Author}" IsVisible="{Binding HasAuthor}" FontSize="11"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ListBox x:Name="ProfileList" Grid.Column="1" Focusable="True" MaxHeight="220"
                 ItemsSource="{Binding GenerationDualSelector.Profiles}"
                 SelectedItem="{Binding GenerationDualSelector.SelectedProfile, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Confirmed generation profiles"
                 AutomationProperties.HelpText="Use arrow keys to preview a confirmed profile. Its tooltip indicates any local draft.">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GenerationDualSelectorProfileItemViewModel">
              <Grid Margin="4,4" ColumnDefinitions="*,Auto" ColumnSpacing="6" ToolTip.Tip="{Binding StateText}">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <PathIcon Grid.Column="1" Width="14" Height="14"
                          IsVisible="{Binding IsBoundToActiveBranch}"
                          Foreground="{DynamicResource SuccessBrush}"
                          AutomationProperties.Name="Profile used by active branch"
                          ToolTip.Tip="Used by this branch"
                          Data="M4,2 L8,2 L8,6 L4,6 Z M5,6 L7,6 L7,10 C7,12 9,13 12,13 L16,13 L16,10 L20,10 L20,14 L18,14 L18,20 L14,20 L14,16 L16,16 L16,15 L12,15 C10,15 8,14 7,13 L7,20 L5,20 Z" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <Button Grid.Row="2" Classes="selector-icon confirm" HorizontalAlignment="Right"
              Command="{Binding ApplyGenerationDualSelectorCommand}"
              IsEnabled="{Binding CanApplyGenerationDualSelector}"
              AutomationProperties.Name="Use selected model and profile for active branch"
              AutomationProperties.HelpText="{Binding GenerationDualSelector.PreviewStatusText}">
        <ToolTip.Tip>
          <StackPanel Spacing="4" MaxWidth="360">
            <TextBlock Text="Use for this branch" />
            <TextBlock Text="{Binding GenerationDualSelector.PreviewStatusText}" TextWrapping="Wrap" />
          </StackPanel>
        </ToolTip.Tip>
        <PathIcon Width="18" Height="18" Data="M3,12 L9,18 L21,6 L23,8 L9,22 L1,14 Z" />
      </Button>
    </Grid>
  </Border>
</UserControl>
