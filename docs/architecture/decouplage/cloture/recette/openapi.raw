    "/healthz": {
      "get": {
        "summary": "Check API health",
        "description": "Technical health check without a PostgreSQL dependency.",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Unhealthy",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "required": [
          "revision",
          "batchId"
        ],
        "type": "object",
        "properties": {
          "revision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "batchId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "budget": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 2048
          },
          "resumeRunId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "ChatOptions": {
        "type": "object",
        "properties": {
          "structuredMemory": {
            "type": "boolean"
          },
          "retrievalMode": {
            "type": "string"
          },
          "embeddingModel": {
            "type": "string"
          },
          "routingMode": {
            "type": "string"
          },
          "temporalMemoryEnabled": {
            "type": "boolean"
          },
          "adaptiveInferenceEnabled": {
            "type": "boolean"
          },
          "claimVerificationEnabled": {
            "type": "boolean"
          },
          "verificationSearchEnabled": {
            "type": "boolean"
          },
          "agentPlanMaxCalls": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "agentPlanningEnabled": {
            "type": "boolean"
          },
          "queryRewriteEnabled": {
            "type": "boolean"
          },
          "maxSearchQueries": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "enrichment": {
            "$ref": "#/components/schemas/EnrichmentOptions"
          },
          "facetPlanningEnabled": {
            "type": "boolean"
          },
          "queryBriefModelEnabled": {
            "type": "boolean"
          },
          "classificationEnabled": {
            "type": "boolean"
          },
          "classificationBudget": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "neutralCandidates": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "relevantThreshold": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "neutralThreshold": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "querySummaryMaxCalls": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "querySummaryTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "memoryContextTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "historyContextTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "hierarchicalIndexEnabled": {
            "type": "boolean"
          },
          "embeddingDocumentPrefix": {
            "type": "string"
          },
          "embeddingQueryPrefix": {
            "type": "string"
          },
          "evidenceSelectionEnabled": {
            "type": "boolean"
          },
          "rerankEnabled": {
            "type": "boolean"
          },
          "rerankCandidateLimit": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "rerankTimeoutMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "tokenCounting": {
            "type": "string"
          },
          "useProjectTools": {
            "type": "boolean"
          },
          "toolMaxCalls": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "toolContextTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "toolResultBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "toolTimeoutSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
