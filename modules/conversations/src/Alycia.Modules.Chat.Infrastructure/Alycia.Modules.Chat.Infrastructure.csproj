<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Using Include="Alycia.Contracts.Documents" />
    <Using Include="Alycia.Contracts.Indexing" />
    <Using Include="Alycia.Contracts.Retrieval" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Alycia.Platform.Persistence" Version="[0.1.0]" />
    <ProjectReference Include="../Alycia.Modules.Chat.Application/Alycia.Modules.Chat.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Alycia.Contracts.Chat" />
    <Using Include="Alycia.Contracts.Tools" />
    <Using Include="Alycia.Contracts.Inference" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Alycia.Contracts.Context" />
  </ItemGroup>
</Project>
